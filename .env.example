# Variables de Entorno - Portafolio Angular

# GitHub API
# NOTA: Cambiar "your-github-username" por tu usuario de GitHub
GITHUB_USERNAME=your-github-username

# Token de GitHub (opcional - para más requests)
# GITHUB_TOKEN=tu_github_token_aqui

# URL del sitio (para SEO)
SITE_URL=https://jcmendez.dev

# Modo producción
# Cuando sea 'true', desactiva logs de desarrollo
PRODUCTION_MODE=false

# Analytics (opcional)
GOOGLE_ANALYTICS_ID=

# Email para formulario de contacto
CONTACT_EMAIL=tu-email@example.com

# Configuración de CORS
# Lista de orígenes permitidos
ALLOWED_ORIGINS=http://localhost:4200,https://jcmendez.dev

# API Backend (si tienes uno)
# API_URL=https://api.ejemplo.com

# Modo debug
DEBUG_MODE=false
